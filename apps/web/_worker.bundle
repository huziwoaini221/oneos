      if (!item[field])
        return false;
      const days = Math.floor((t - new Date(item[field]).getTime()) / 864e5);
      const operator = cond.operator || "days_gt";
      if (operator === "days_gt")
        return days > cond.value;
      if (operator === "days_gte")
        return days >= cond.value;
      return false;
    }
    case "deadline_before": {
      if (!item.deadline)
        return false;
      if (item.status === "completed" || item.status === "cancelled")
        return false;
      const diffHours = (new Date(item.deadline).getTime() - t) / 36e5;
      return diffHours >= 0 && diffHours <= (cond.hours ?? 24);
